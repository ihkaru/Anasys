#!/usr/bin/env sh

echo "============================================="
echo "🚀 Running Pre-Push Checks (Type & Lint)"
echo "============================================="

echo "1/2 🔍 Running TypeScript Compiler (Cross-file check)..."
bun run typecheck

if [ $? -ne 0 ]; then
  echo "❌ TypeScript check failed. Push aborted."
  exit 1
fi

echo "2/2 🦀 Running Rust Cargo Check..."
cd apps/engine && CARGO_TARGET_DIR=../../target-local cargo check

if [ $? -ne 0 ]; then
  echo "❌ Cargo check failed. Push aborted."
  exit 1
fi

echo "✅ All checks passed. Pushing to remote..."
