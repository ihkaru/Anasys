{
	"name": "finance-app-monorepo",
	"version": "0.0.1",
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"setup": "bun run scripts/setup.ts",
		"dev": "bun --filter '*' dev",
		"restart": "fuser -k 3000/tcp 5173/tcp || true && echo 'Stopped.' && sleep 1 && bun run dev",
		"build": "bun --filter '*' build",
		"test": "bun --filter @apps/backend test",
		"test:consistency": "bun --filter @apps/backend run test:consistency",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"db:push": "bun --filter @packages/db push",
		"db:studio": "bun --filter @packages/db studio",
		"db:seed": "bun --filter @apps/backend seed",
		"db:audit": "bun --filter @apps/backend audit",
		"db:repair": "bun --filter @apps/backend repair",
		"db:repair:vip": "bun --filter @apps/backend repair:vip",
		"db:clean": "bun --filter @apps/backend clean-slate",
		"db:prune": "bun --filter @apps/backend prune",
		"db:prune:dry": "bun --filter @apps/backend prune:dry",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"bun-types": "latest",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"typescript": "^5.0.0"
	}
}
