# Stage 1: Plan recipes
# Per Mei 2026: Pakai rust:alpine sebagai base untuk konsistensi musl environment
FROM rust:alpine AS chef
RUN apk add --no-cache musl-dev gcc make perl
RUN cargo install cargo-chef
WORKDIR /app

# Stage 2: Planner
FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# Stage 3: Build dependencies (Cacher)
FROM chef AS cacher
COPY --from=planner /app/recipe.json recipe.json
# BuildKit Cache Mounts untuk mempercepat build antar-run
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo chef cook --release --target x86_64-unknown-linux-musl --recipe-path recipe.json

# Stage 4: Build application
FROM chef AS builder
COPY . .
COPY --from=cacher /app/target target
COPY --from=cacher /usr/local/cargo /usr/local/cargo
# Build static binary
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo build --release --target x86_64-unknown-linux-musl

# Stage 5: Runtime — Minimal Alpine image
# Alpine 3.23 adalah versi stabil per Mei 2026
FROM alpine:3.23
RUN apk add --no-cache ca-certificates curl

# Non-root user
RUN addgroup -g 1000 anasys && adduser -u 1000 -G anasys -s /bin/sh -D anasys
USER anasys

WORKDIR /app
# Path binary berubah karena ada target triplet musl
COPY --from=builder /app/target/x86_64-unknown-linux-musl/release/anasys-engine /app/anasys-engine

ENV RUST_LOG=info
CMD ["./anasys-engine"]
