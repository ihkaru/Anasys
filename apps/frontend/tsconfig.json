{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"]
		},
		"jsx": "preserve",
		"jsxImportSource": "vue",
		"moduleResolution": "bundler",
		"skipLibCheck": true,
		"types": []
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue", "src/vite-env.d.ts"],
	"exclude": ["node_modules"]
}
