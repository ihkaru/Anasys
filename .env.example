# -----------------------------------------------------------------------------
# Anasys Environment Configuration
# -----------------------------------------------------------------------------

# General
NODE_ENV=production
PORT=3000

# Google Auth
# Digunakan oleh backend (auth.service.ts) dan frontend (VITE_ prefix)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID

# Database Credentials
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=finance_db

# Connection URLs
# For Docker (Coolify):
DATABASE_URL=postgres://postgres:postgres@postgres:5432/finance_db
REDIS_URL=redis://redis:6379
QUESTDB_URL=http://questdb:9000

# CORS & Frontend API Access
# CORS_ORIGIN: Domain frontend Anda (tanpa slash di akhir)
CORS_ORIGIN=https://anasys.dvlpid.my.id
# VITE_API_URL: Domain backend Anda (untuk akses dari browser)
VITE_API_URL=https://anasys-api.dvlpid.my.id

# Market Data Harvester
ANASYS_SCRAPE_SYMBOLS=BINANCE:BTCUSDT,BINANCE:ETHUSDT,FX:EURUSD,NASDAQ:AAPL,NASDAQ:TSLA
# Playwright Browser Config
# HEADLESS=true

# Security
JWT_SECRET=generate_a_strong_secret_key_here

# Logging & Monitoring
LOG_LEVEL=INFO
LOG_MODULES=*

# Performance Settings
RUNNING_IN_DOCKER=true
