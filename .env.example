# -----------------------------------------------------------------------------
# Anasys Environment Configuration
# -----------------------------------------------------------------------------

# Google Auth (Optional for now)
GS_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID

# Database Credentials
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=finance_db

# Connection URLs
# For Docker (Coolify):
# DATABASE_URL=postgres://postgres:postgres@postgres:5432/finance_db
# REDIS_URL=redis://redis:6379
# QUESTDB_URL=http://questdb:9000

# For Local Development (Host Access):
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:25432/finance_db
REDIS_URL=redis://127.0.0.1:26380
QUESTDB_URL=http://127.0.0.1:29010

# Market Data Harvester
ANASYS_SCRAPE_SYMBOLS=BINANCE:BTCUSDT,BINANCE:ETHUSDT,FX:EURUSD,NASDAQ:AAPL,NASDAQ:TSLA
# Playwright Browser Config
# HEADLESS=true

# Security
JWT_SECRET=generate_a_strong_secret_key_here

# Logging & Monitoring
# Use INFO for production to save storage
LOG_LEVEL=INFO
# Filter modules: LOG_MODULES=market,playwright
LOG_MODULES=*

# Performance Settings
# Set to 'true' if running in a container to optimize memory
RUNNING_IN_DOCKER=false
